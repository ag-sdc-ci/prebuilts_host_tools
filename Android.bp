package {
    default_applicable_licenses: ["prebuilts_host_tools_license"],
}

license {
    name: "prebuilts_host_tools_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD-3-Clause",
    ],
    license_text: [
        "LICENSE",
    ],
}

// Android Debug Bridge & Fastboot
cc_prebuilt_binary {
    name: "adb",
    srcs: ["bin/adb"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "fastboot",
    srcs: ["bin/fastboot"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

